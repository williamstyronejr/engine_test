execute_process(COMMAND "${PROBE}" "${REPORT}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(result EQUAL 77)
  message("SKIP: UI allocation workload DISPLAY unavailable")
  return()
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "UI allocation workload failed: ${output} ${errors}")
endif()
file(READ "${REPORT}" json)
string(JSON schema GET "${json}" schema)
string(JSON complete GET "${json}" complete)
string(JSON count LENGTH "${json}" scenarios)
string(JSON measured GET "${json}" measured_frames)
string(JSON frames GET "${json}" frames)
string(JSON warmup GET "${json}" warmup)
if(NOT schema STREQUAL "feature_lab_ui_allocations_v1" OR NOT complete OR NOT count EQUAL 18 OR
   NOT measured EQUAL 270 OR NOT frames EQUAL 300 OR NOT warmup EQUAL 30)
  message(FATAL_ERROR "Incorrect UI workload shape")
endif()
set(names audio_off audio_default audio_remapped settings_default controls_remapped binding_capture
  binding_updated diagnostics diagnostics_shapes)
foreach(i RANGE 0 17)
  math(EXPR scenario "${i} % 9")
  list(GET names ${scenario} expected)
  string(JSON name GET "${json}" scenarios ${i} name)
  string(JSON level GET "${json}" scenarios ${i} level)
  if(i LESS 9)
    set(expected_level facility)
  else()
    set(expected_level annex)
  endif()
  if(NOT name STREQUAL expected OR NOT level STREQUAL expected_level)
    message(FATAL_ERROR "Missing or reordered UI scenario")
  endif()
  foreach(metric calls requested_bytes)
    set(sum 0)
    foreach(scope settings_update minimap_submit world_submit hud_submit diagnostics_submit settings_submit render_end)
      string(JSON value GET "${json}" scenarios ${i} scopes ${scope} ${metric})
      math(EXPR sum "${sum} + ${value}")
    endforeach()
    string(JSON total GET "${json}" scenarios ${i} scopes frame ${metric})
    if(NOT sum EQUAL total)
      message(FATAL_ERROR "UI frame lost allocation accounting")
    endif()
  endforeach()
  foreach(scope settings_update minimap_submit world_submit hud_submit diagnostics_submit settings_submit render_end frame)
    string(JSON samples GET "${json}" scenarios ${i} scopes ${scope} samples)
    string(JSON nonzero GET "${json}" scenarios ${i} scopes ${scope} nonzero_samples)
    string(JSON calls GET "${json}" scenarios ${i} scopes ${scope} calls)
    if(NOT samples EQUAL measured OR nonzero GREATER samples OR calls LESS nonzero)
      message(FATAL_ERROR "Invalid ${name}/${scope} counters")
    endif()
  endforeach()
  foreach(state audio settings controls capture diagnostics shapes)
    set(expected_state FALSE)
    if((state STREQUAL "audio" AND scenario GREATER 0) OR
       (state STREQUAL "settings" AND scenario GREATER_EQUAL 3 AND scenario LESS_EQUAL 6) OR
       (state STREQUAL "controls" AND scenario GREATER_EQUAL 4 AND scenario LESS_EQUAL 6) OR
       (state STREQUAL "capture" AND scenario EQUAL 5) OR
       (state STREQUAL "diagnostics" AND scenario GREATER_EQUAL 7) OR
       (state STREQUAL "shapes" AND scenario EQUAL 8))
      set(expected_state TRUE)
    endif()
    string(JSON actual GET "${json}" scenarios ${i} state ${state})
    if((actual AND NOT expected_state) OR (NOT actual AND expected_state))
      message(FATAL_ERROR "Wrong ${name}/${state} state")
    endif()
  endforeach()
  string(JSON label GET "${json}" scenarios ${i} state audio_label)
  if(scenario EQUAL 0)
    set(expected_label "AUDIO OFF")
  elseif(scenario EQUAL 2 OR (scenario GREATER_EQUAL 4 AND scenario LESS_EQUAL 6))
    set(expected_label "C+S+A+NTILDE MUTED / C+S+U+03BB MUSIC 15 / C+S+A+U+1F642 EFFECTS 25")
  else()
    set(expected_label "M SOUND ON / N MUSIC 30 / B EFFECTS 50")
  endif()
  if(NOT label STREQUAL expected_label)
    message(FATAL_ERROR "Wrong enabled/remapped audio label: ${label}")
  endif()
  if(scenario EQUAL 6)
    string(JSON binding GET "${json}" scenarios ${i} state binding_label)
    if(NOT binding STREQUAL "MOVE LEFT : C+S+OUML")
      message(FATAL_ERROR "Rebound label was stale")
    endif()
  endif()
  foreach(transition open controls capture rebind)
    set(expected_samples 0)
    if((transition STREQUAL "open" AND scenario GREATER_EQUAL 3 AND scenario LESS_EQUAL 6) OR
       (transition STREQUAL "controls" AND scenario GREATER_EQUAL 4 AND scenario LESS_EQUAL 6) OR
       (transition STREQUAL "capture" AND scenario GREATER_EQUAL 5 AND scenario LESS_EQUAL 6) OR
       (transition STREQUAL "rebind" AND scenario EQUAL 6))
      set(expected_samples 1)
    endif()
    string(JSON samples GET "${json}" scenarios ${i} transitions ${transition} samples)
    if(NOT samples EQUAL expected_samples)
      message(FATAL_ERROR "Missing transition accounting")
    endif()
    if(transition STREQUAL "open" AND expected_samples)
      string(JSON calls GET "${json}" scenarios ${i} transitions ${transition} calls)
      if(calls EQUAL 0)
        message(FATAL_ERROR "Layout allocation positive control missing")
      endif()
    endif()
  endforeach()
  string(JSON quads GET "${json}" scenarios ${i} render quads)
  if(quads LESS 100)
    message(FATAL_ERROR "Empty UI render")
  endif()
endforeach()
message(STATUS "18 UI scenarios: states, labels, samples and inclusive counters verified")
