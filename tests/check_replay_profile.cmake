if("$ENV{DISPLAY}" STREQUAL "")
  message("SKIP: replay profile DISPLAY unavailable")
  return()
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(level facility annex)
  set(replay "${OUTPUT_DIR}/${level}.erpl")
  set(report "${OUTPUT_DIR}/${level}.json")
  execute_process(COMMAND "${FIXTURE_EXE}" "${replay}" "${level}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture failed: ${output} ${errors}")
  endif()
  execute_process(COMMAND "${GAME_EXE}" --verify-replay "${replay}"
    RESULT_VARIABLE result OUTPUT_VARIABLE verified ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "CPU replay failed: ${verified} ${errors}")
  endif()
  string(REGEX MATCH "hash=([0-9]+)" matched "${verified}")
  set(expected_hash "${CMAKE_MATCH_1}")
  set(config_home "${OUTPUT_DIR}/unused-config-${level}")
  set(state_home "${OUTPUT_DIR}/unused-state-${level}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "XDG_CONFIG_HOME=${config_home}" "XDG_STATE_HOME=${state_home}"
    "${GAME_EXE}" --replay "${replay}" --profile-report "${report}" --profile-warmup 30
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Profile failed: ${output} ${errors}")
  endif()
  if(EXISTS "${config_home}" OR EXISTS "${state_home}")
    message(FATAL_ERROR "Profile touched user storage")
  endif()
  file(READ "${report}" json)
  foreach(field complete)
    string(JSON value GET "${json}" run ${field})
    if(NOT value)
      message(FATAL_ERROR "Incomplete profile")
    endif()
  endforeach()
  string(JSON method GET "${json}" gpu_queries method)
  string(JSON supported GET "${json}" gpu_queries supported)
  string(JSON bits GET "${json}" gpu_queries counter_bits)
  if(NOT method STREQUAL "time_elapsed" OR (supported AND NOT bits EQUAL 64))
    message(FATAL_ERROR "Unexpected GPU timing method/capability: ${json}")
  endif()
  string(JSON hash GET "${json}" run final_hash)
  string(JSON frames GET "${json}" run frames)
  string(JSON measured GET "${json}" run measured_frames)
  string(JSON audio GET "${json}" run audio_device)
  if(NOT "${hash}" STREQUAL "${expected_hash}" OR NOT frames EQUAL 3000 OR NOT measured EQUAL 2970 OR audio)
    message(FATAL_ERROR "Replay/profile mismatch: ${json}")
  endif()
  foreach(scope simulation minimap_submit world_submit ui_submit present frame)
    string(JSON count GET "${json}" milliseconds ${scope} samples)
    if(NOT count EQUAL 2970)
      message(FATAL_ERROR "Wrong ${scope} sample count: ${count}")
    endif()
  endforeach()
  foreach(flag --frames --profile-warmup)
    execute_process(COMMAND "${GAME_EXE}" --replay "${replay}" --profile-report "${report}" ${flag} 3000
      RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
    if(rejected EQUAL 0)
      message(FATAL_ERROR "Accepted incompatible/empty measurement options")
    endif()
    file(READ "${report}" after)
    if(NOT "${after}" STREQUAL "${json}")
      message(FATAL_ERROR "Rejected options replaced the report")
    endif()
  endforeach()
  file(SHA256 "${replay}" before)
  execute_process(COMMAND "${GAME_EXE}" --replay "${replay}" --profile-report "${replay}"
    RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
  file(SHA256 "${replay}" after)
  if(rejected EQUAL 0 OR NOT "${before}" STREQUAL "${after}")
    message(FATAL_ERROR "Profile did not preserve its replay input")
  endif()
endforeach()
