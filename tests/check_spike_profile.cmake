if("$ENV{DISPLAY}" STREQUAL "")
  message("SKIP: spike profile DISPLAY unavailable")
  return()
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
execute_process(COMMAND "${REFERENCE_EXE}" --reference "${OUTPUT_DIR}/reference.json"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "CPU spike reference failed: ${output} ${errors}")
endif()
set(config "${OUTPUT_DIR}/unused-config")
set(state "${OUTPUT_DIR}/unused-state")
set(report "${OUTPUT_DIR}/native.json")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "XDG_CONFIG_HOME=${config}" "XDG_STATE_HOME=${state}"
  "${GAME_EXE}" --spike-report "${report}" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 90)
file(WRITE "${OUTPUT_DIR}/native.log" "${output}${errors}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Spike profile failed: ${output} ${errors}")
endif()
if(EXISTS "${config}" OR EXISTS "${state}")
  message(FATAL_ERROR "Spike profile touched user storage")
endif()
file(READ "${report}" json)
file(READ "${OUTPUT_DIR}/reference.json" reference)
string(JSON actual_usage GET "${json}" spikes collision_memory)
string(JSON expected_usage GET "${reference}" spikes collision_memory)
if(NOT "${actual_usage}" STREQUAL "${expected_usage}")
  message(FATAL_ERROR "Native collision utilization differs from CPU reference")
endif()
string(JSON usage_levels LENGTH "${json}" spikes collision_memory levels)
if(NOT usage_levels EQUAL 2)
  message(FATAL_ERROR "Missing collision utilization for a level")
endif()
foreach(field final_hash ticks frames measured_frames)
  string(JSON expected GET "${reference}" run ${field})
  string(JSON actual GET "${json}" run ${field})
  if(NOT "${expected}" STREQUAL "${actual}")
    message(FATAL_ERROR "Native/reference ${field} mismatch: ${expected} vs ${actual}")
  endif()
endforeach()
string(JSON complete GET "${json}" run complete)
string(JSON stable GET "${json}" spikes resources_stable)
string(JSON count LENGTH "${json}" spikes events)
string(JSON method GET "${json}" gpu_queries method)
if(NOT complete OR NOT stable OR NOT count EQUAL 10 OR NOT method STREQUAL "time_elapsed")
  message(FATAL_ERROR "Invalid spike report: ${json}")
endif()
set(reload_bytes 0)
foreach(texture actors checker tiles white)
  file(SIZE "${ASSET_ROOT}/textures/${texture}.etex" encoded_bytes)
  math(EXPR reload_bytes "${reload_bytes} + ${encoded_bytes} - 16")
endforeach()
foreach(i RANGE 0 9)
  string(JSON coverage GET "${json}" spikes events ${i} staging coverage)
  if(NOT coverage STREQUAL "owned_payload_v2")
    message(FATAL_ERROR "Missing parser staging coverage")
  endif()
  string(JSON measured GET "${json}" spikes events ${i} staging measured)
  string(JSON cpu_peak GET "${json}" spikes events ${i} staging cpu_peak_bytes)
  string(JSON gpu_peak GET "${json}" spikes events ${i} staging gpu_peak_bytes)
  string(JSON combined GET "${json}" spikes events ${i} staging combined_peak_bytes)
  string(JSON cpu_left GET "${json}" spikes events ${i} staging cpu_remaining_bytes)
  string(JSON gpu_left GET "${json}" spikes events ${i} staging gpu_remaining_bytes)
  if(NOT measured OR NOT cpu_left EQUAL 0 OR NOT gpu_left EQUAL 0 OR
     combined LESS cpu_peak OR combined LESS gpu_peak)
    message(FATAL_ERROR "Invalid staging accounting for event ${i}")
  endif()
  # Static shader failure strings own no source buffers. All other operations
  # stage CPU payloads; only successful texture/font uploads stage GPU texels.
  if(NOT i EQUAL 1 AND NOT cpu_peak GREATER 0)
    message(FATAL_ERROR "Missing CPU staging for event ${i}")
  endif()
  if(i EQUAL 3 OR i EQUAL 5)
    set(expected_gpu ${reload_bytes})
  elseif(i EQUAL 6)
    string(JSON expected_gpu GET "${json}" spikes events ${i} before font_bytes)
  else()
    set(expected_gpu 0)
  endif()
  if(NOT gpu_peak EQUAL expected_gpu)
    message(FATAL_ERROR "Unexpected GPU staging for event ${i}: ${gpu_peak}")
  endif()
  string(JSON verified GET "${json}" spikes events ${i} verified)
  if(NOT verified)
    message(FATAL_ERROR "Unverified event ${i}")
  endif()
  foreach(field frame action)
    string(JSON expected GET "${reference}" spikes events ${i} ${field})
    string(JSON actual GET "${json}" spikes events ${i} ${field})
    if(NOT "${expected}" STREQUAL "${actual}")
      message(FATAL_ERROR "Event ${i} ${field} differs from reference")
    endif()
  endforeach()
  foreach(side before after)
    foreach(field hash level shader_revision texture_revision font_revision)
      string(JSON expected GET "${reference}" spikes events ${i} ${side} ${field})
      string(JSON actual GET "${json}" spikes events ${i} ${side} ${field})
      if(NOT "${expected}" STREQUAL "${actual}")
        message(FATAL_ERROR "Event ${i} ${side} ${field}: expected ${expected}, got ${actual}")
      endif()
    endforeach()
  endforeach()
  string(JSON neighbors LENGTH "${json}" spikes events ${i} nearby_frames)
  if(NOT neighbors EQUAL 5)
    message(FATAL_ERROR "Missing frame neighborhood")
  endif()
endforeach()
execute_process(COMMAND "${GAME_EXE}" --spike-report "${report}" --frames 1
  RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
file(READ "${report}" after)
if(rejected EQUAL 0 OR NOT "${after}" STREQUAL "${json}")
  message(FATAL_ERROR "Incompatible options did not preserve existing report")
endif()
# An unexpected reload failure retains an incomplete report; never edit source assets.
file(COPY "${ASSET_ROOT}/" DESTINATION "${OUTPUT_DIR}/broken-assets")
file(WRITE "${OUTPUT_DIR}/broken-assets/shaders/sprite.frag"
  "#version 460 core\n#error injected unexpected profile failure\n")
file(REMOVE "${OUTPUT_DIR}/failed.json")
execute_process(COMMAND "${GAME_EXE}" --assets "${OUTPUT_DIR}/broken-assets"
  --spike-report "${OUTPUT_DIR}/failed.json" RESULT_VARIABLE rejected
  OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
file(WRITE "${OUTPUT_DIR}/failed.log" "${output}${errors}")
file(READ "${OUTPUT_DIR}/failed.json" failed)
string(JSON complete GET "${failed}" run complete)
string(JSON frames GET "${failed}" run frames)
string(JSON verified GET "${failed}" spikes events 0 verified)
string(JSON diagnostic GET "${failed}" spikes events 0 diagnostic)
string(JSON cpu_peak GET "${failed}" spikes events 0 staging cpu_peak_bytes)
string(JSON cpu_left GET "${failed}" spikes events 0 staging cpu_remaining_bytes)
string(JSON gpu_left GET "${failed}" spikes events 0 staging gpu_remaining_bytes)
if(NOT cpu_peak GREATER 0 OR NOT cpu_left EQUAL 0 OR NOT gpu_left EQUAL 0)
  message(FATAL_ERROR "Unexpected shader failure did not retain clean staging evidence")
endif()
if(rejected EQUAL 0 OR complete OR verified OR NOT frames EQUAL 120 OR diagnostic STREQUAL "")
  message(FATAL_ERROR "Unexpected reload failure was not retained: ${failed}")
endif()
# Fail in loading/parsing, before preflight and publication. Only Annex inputs
# are damaged so startup and the Facility route still complete normally.
foreach(kind scene tile)
  set(broken "${OUTPUT_DIR}/broken-${kind}")
  file(COPY "${ASSET_ROOT}/" DESTINATION "${broken}")
  if(kind STREQUAL "scene")
    file(APPEND "${broken}/annex.scene" "unexpected\n")
    set(expected_diagnostic "Data after end")
  else()
    file(APPEND "${broken}/annex.etmp" "x")
    set(expected_diagnostic "Trailing data")
  endif()
  set(failure_report "${OUTPUT_DIR}/failed-${kind}.json")
  file(REMOVE "${failure_report}")
  execute_process(COMMAND "${GAME_EXE}" --assets "${broken}" --spike-report "${failure_report}"
    RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
  file(WRITE "${OUTPUT_DIR}/failed-${kind}.log" "${output}${errors}")
  file(READ "${failure_report}" failed)
  string(JSON complete GET "${failed}" run complete)
  string(JSON frames GET "${failed}" run frames)
  string(JSON count LENGTH "${failed}" spikes events)
  string(JSON verified GET "${failed}" spikes events 8 verified)
  string(JSON usage_levels LENGTH "${failed}" spikes collision_memory levels)
  string(JSON usage_level GET "${failed}" spikes collision_memory levels 0 level)
  if(NOT usage_levels EQUAL 1 OR NOT usage_level EQUAL 0)
    message(FATAL_ERROR "Malformed transition published candidate collision telemetry")
  endif()
  if(NOT rejected EQUAL 1 OR complete OR verified OR NOT frames EQUAL 1383 OR NOT count EQUAL 9)
    message(FATAL_ERROR "Malformed ${kind} transition did not retain its partial report")
  endif()
  foreach(i RANGE 7 8)
    string(JSON before GET "${failed}" spikes events ${i} before)
    string(JSON after GET "${failed}" spikes events ${i} after)
    string(JSON applied GET "${failed}" spikes events ${i} applied)
    string(JSON diagnostic GET "${failed}" spikes events ${i} diagnostic)
    string(JSON measured GET "${failed}" spikes events ${i} staging measured)
    string(JSON peak GET "${failed}" spikes events ${i} staging cpu_peak_bytes)
    string(JSON cpu_left GET "${failed}" spikes events ${i} staging cpu_remaining_bytes)
    string(JSON gpu_left GET "${failed}" spikes events ${i} staging gpu_remaining_bytes)
    if(NOT "${before}" STREQUAL "${after}" OR applied OR NOT measured OR NOT peak GREATER 0 OR
       NOT cpu_left EQUAL 0 OR NOT gpu_left EQUAL 0 OR NOT diagnostic MATCHES "${expected_diagnostic}")
      message(FATAL_ERROR "Malformed ${kind} transition lost state/cleanup/diagnostic evidence")
    endif()
  endforeach()
endforeach()
