cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED STRESS_EXE OR NOT DEFINED REPORT_PATH)
  message(FATAL_ERROR "Missing stress report test paths")
endif()
execute_process(COMMAND "${STRESS_EXE}" --frames 3 --warmup 2 --cycles 2
  --sprites 32 --entities 16 --bodies 16 --tiles 64 --voices 2 --report "${REPORT_PATH}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Stress run failed: ${errors}")
endif()
file(READ "${REPORT_PATH}" report)
function(expect expected)
  string(JSON value GET "${report}" ${ARGN})
  if(NOT "${value}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${value}")
  endif()
endfunction()
expect(feature_lab_stress_v1 schema)
expect(cpu mode)
expect(ON complete)
expect(ON resources_stable)
expect(2 run completed_cycles)
expect(6 run measured_frames)
expect(6 milliseconds simulation samples)
expect(6 milliseconds mixer samples)
expect(6 milliseconds frame samples)
expect(2 milliseconds load samples)
expect(0 milliseconds render_submit samples)
expect(0 milliseconds preview_submit samples)
expect(0 milliseconds present samples)
expect(0 milliseconds gpu_render samples)
expect(time_elapsed gpu_queries method)
expect(0 gpu_queries counter_bits)
expect(8 gpu_queries failure_capacity)
expect(0 gpu_queries failures_omitted)
string(JSON failure_count LENGTH "${report}" gpu_queries failures)
if(NOT failure_count EQUAL 0)
  message(FATAL_ERROR "CPU report contains GPU timestamp failures")
endif()
expect(0 memory peak_targets)
expect(0 memory peak_uploaded_texture_bytes)
execute_process(COMMAND "${STRESS_EXE}" --frames 0 --report "${REPORT_PATH}"
  RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
if(rejected EQUAL 0)
  message(FATAL_ERROR "Invalid run was accepted")
endif()
file(READ "${REPORT_PATH}" after)
if(NOT "${report}" STREQUAL "${after}")
  message(FATAL_ERROR "Invalid run replaced a valid report")
endif()

string(JSON optional ERROR_VARIABLE absent GET "${report}" frame_samples)
if(NOT absent)
  message(FATAL_ERROR "Default report unexpectedly retains per-frame samples")
endif()
execute_process(COMMAND "${STRESS_EXE}" --frames 3 --warmup 2 --cycles 2 --frame-samples
  --sprites 32 --entities 16 --bodies 16 --tiles 64 --voices 2 --report "${REPORT_PATH}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Traced CPU run failed: ${errors}")
endif()
file(READ "${REPORT_PATH}" report)
expect(stress_frame_samples_v1 frame_samples schema)
string(JSON rows LENGTH "${report}" frame_samples rows)
if(NOT rows EQUAL 6)
  message(FATAL_ERROR "Incorrect CPU trace size")
endif()
foreach(i RANGE 0 5)
  math(EXPR tag "(${i} / 3) * 5 + 3 + ${i} % 3")
  expect(${tag} frame_samples rows ${i} frame)
  expect(not_submitted frame_samples rows ${i} gpu_status)
  string(JSON kind TYPE "${report}" frame_samples rows ${i} gpu_ms)
  if(NOT kind STREQUAL "NULL")
    message(FATAL_ERROR "CPU trace invented a GPU duration")
  endif()
endforeach()

expect(none presentation mode)
expect(OFF presentation request_issued)
expect(0 presentation present_calls)
string(JSON kind TYPE "${report}" presentation swap_interval_requested)
if(NOT kind STREQUAL "NULL")
  message(FATAL_ERROR "CPU report claims a swap request")
endif()
foreach(mode immediate vsync)
  execute_process(COMMAND "${STRESS_EXE}" --presentation ${mode} --report "${REPORT_PATH}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    message(FATAL_ERROR "CPU stress accepted a presentation mode")
  endif()
  file(READ "${REPORT_PATH}" after)
  if(NOT after STREQUAL report)
    message(FATAL_ERROR "Rejected presentation option replaced a report")
  endif()
endforeach()

execute_process(COMMAND "${STRESS_EXE}" --frame-samples --submission-samples --report "${REPORT_PATH}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${REPORT_PATH}" after)
if(result EQUAL 0 OR NOT after STREQUAL report)
  message(FATAL_ERROR "CPU submission trace accepted or replaced a valid report")
endif()

execute_process(COMMAND "${STRESS_EXE}" --frame-samples --submission-samples --preparation-samples --report "${REPORT_PATH}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${REPORT_PATH}" after)
if(result EQUAL 0 OR NOT after STREQUAL report)
  message(FATAL_ERROR "CPU preparation trace accepted or replaced a valid report")
endif()

execute_process(COMMAND "${STRESS_EXE}" --frame-samples --submission-samples --preparation-samples --context-samples --report "${REPORT_PATH}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${REPORT_PATH}" after)
if(result EQUAL 0 OR NOT after STREQUAL report)
  message(FATAL_ERROR "CPU context trace accepted or replaced a valid report")
endif()
