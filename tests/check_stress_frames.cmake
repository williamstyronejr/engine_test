if("$ENV{DISPLAY}" STREQUAL "")
  message("SKIP: stress frame samples DISPLAY unavailable")
  return()
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(mode plain traced)
  set(flags)
  if(mode STREQUAL traced)
    set(flags --frame-samples)
  endif()
  execute_process(COMMAND "${GAME_EXE}" --stress --frames 12 --warmup 3 --cycles 2
    --sprites 64 --tiles 64 --entities 16 --bodies 16 --voices 2 --width 256 --height 144
    ${flags} --report "${OUTPUT_DIR}/${mode}.json" --screenshot "${OUTPUT_DIR}/${mode}.ppm"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${mode} stress failed: ${errors}")
  endif()
  file(READ "${OUTPUT_DIR}/${mode}.json" ${mode})
endforeach()
foreach(path "run;checksum" "totals" "workload" "memory;report_buffer_bytes"
    "memory;tracked_cpu_buffer_bytes" "run;window_width" "run;window_height")
  string(JSON before GET "${plain}" ${path})
  string(JSON after GET "${traced}" ${path})
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Tracing changed ${path}")
  endif()
endforeach()
file(SHA256 "${OUTPUT_DIR}/plain.ppm" before)
file(SHA256 "${OUTPUT_DIR}/traced.ppm" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Tracing changed rendered pixels")
endif()
string(JSON rows LENGTH "${traced}" frame_samples rows)
string(JSON stable GET "${traced}" resources_stable)
string(JSON complete GET "${traced}" complete)
if(NOT rows EQUAL 24 OR NOT stable OR NOT complete)
  message(FATAL_ERROR "Incomplete frame trace")
endif()
set(completed 0)
set(max_frame 0)
foreach(i RANGE 0 23)
  math(EXPR expected "(${i} / 12) * 15 + 4 + ${i} % 12")
  string(JSON tag GET "${traced}" frame_samples rows ${i} frame)
  string(JSON status GET "${traced}" frame_samples rows ${i} gpu_status)
  string(JSON duration GET "${traced}" frame_samples rows ${i} cpu_ms 6)
  if(NOT tag EQUAL expected OR duration LESS 0)
    message(FATAL_ERROR "Wrong trace frame tag/duration")
  endif()
  if(duration GREATER max_frame)
    set(max_frame ${duration})
  endif()
  if(status STREQUAL "completed")
    math(EXPR completed "${completed} + 1")
    string(JSON gpu GET "${traced}" frame_samples rows ${i} gpu_ms)
    string(JSON collected GET "${traced}" frame_samples rows ${i} gpu_collected_after)
    if(gpu LESS 0 OR collected LESS tag OR collected GREATER 30)
      message(FATAL_ERROR "GPU result paired to the wrong frame")
    endif()
  elseif(status STREQUAL "uncollected" OR status STREQUAL "not_submitted")
    foreach(field gpu_ms gpu_collected_after)
      string(JSON kind TYPE "${traced}" frame_samples rows ${i} ${field})
      if(NOT kind STREQUAL "NULL")
        message(FATAL_ERROR "Missing GPU result is not null")
      endif()
    endforeach()
  else()
    message(FATAL_ERROR "Unknown GPU sample status")
  endif()
endforeach()
string(JSON aggregate GET "${traced}" milliseconds gpu_render samples)
string(JSON maximum GET "${traced}" milliseconds frame max)
if(NOT completed EQUAL aggregate OR NOT max_frame EQUAL maximum)
  message(FATAL_ERROR "Trace/aggregate mismatch")
endif()
