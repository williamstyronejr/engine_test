cmake_minimum_required(VERSION 3.21)
if("$ENV{DISPLAY}" STREQUAL "")
  message("SKIP: stress frame samples DISPLAY unavailable")
  return()
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(mode plain traced vsync split split_vsync prep prep_vsync)
  set(flags)
  if(mode STREQUAL "traced")
    set(flags --frame-samples --presentation immediate)
  elseif(mode STREQUAL "vsync")
    set(flags --frame-samples --presentation vsync)
  elseif(mode STREQUAL "split")
    set(flags --frame-samples --submission-samples --presentation immediate)
  elseif(mode STREQUAL "split_vsync")
    set(flags --frame-samples --submission-samples --presentation vsync)
  elseif(mode STREQUAL "prep")
    set(flags --frame-samples --submission-samples --preparation-samples --presentation immediate)
  elseif(mode STREQUAL "prep_vsync")
    set(flags --frame-samples --submission-samples --preparation-samples --presentation vsync)
  endif()
  execute_process(COMMAND "${GAME_EXE}" --stress --frames 12 --warmup 3 --cycles 2
    --sprites 64 --tiles 64 --entities 16 --bodies 16 --voices 2 --width 256 --height 144
    ${flags} --report "${OUTPUT_DIR}/${mode}.json" --screenshot "${OUTPUT_DIR}/${mode}.ppm"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${mode} stress failed: ${errors}")
  endif()
  file(READ "${OUTPUT_DIR}/${mode}.json" ${mode})
endforeach()
foreach(mode traced vsync split split_vsync prep prep_vsync)
    set(traced "${${mode}}")
  foreach(path "run;checksum" "totals" "workload" "memory;report_buffer_bytes"
      "memory;tracked_cpu_buffer_bytes" "run;window_width" "run;window_height")
    string(JSON before GET "${plain}" ${path})
    string(JSON after GET "${traced}" ${path})
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Tracing changed ${path}")
    endif()
  endforeach()
  file(SHA256 "${OUTPUT_DIR}/plain.ppm" before)
  file(SHA256 "${OUTPUT_DIR}/${mode}.ppm" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Tracing changed rendered pixels")
  endif()
  string(JSON presentation GET "${traced}" presentation mode)
  string(JSON interval GET "${traced}" presentation swap_interval_requested)
  string(JSON issued GET "${traced}" presentation request_issued)
  string(JSON requested GET "${traced}" run vsync_requested)
  string(JSON disabled GET "${traced}" run vsync_disable_accepted)
  string(JSON calls GET "${traced}" presentation present_calls)
  if(NOT calls EQUAL 30)
    message(FATAL_ERROR "Presentation count does not include all warmup/measured frames")
  endif()
  if(mode STREQUAL "vsync" OR mode MATCHES "_vsync$")
    if(NOT presentation STREQUAL "vsync" OR NOT interval EQUAL 1 OR NOT requested OR disabled)
      message(FATAL_ERROR "Misreported VSync request")
    endif()
  else()
    if(NOT presentation STREQUAL "immediate" OR NOT interval EQUAL 0 OR requested OR NOT disabled STREQUAL issued)
      message(FATAL_ERROR "Misreported immediate request")
    endif()
  endif()
  string(JSON rows LENGTH "${traced}" frame_samples rows)
  string(JSON stable GET "${traced}" resources_stable)
  string(JSON complete GET "${traced}" complete)
  if(NOT rows EQUAL 24 OR NOT stable OR NOT complete)
    message(FATAL_ERROR "Incomplete frame trace")
  endif()
  if(mode MATCHES "^(split|prep)")
    string(JSON count LENGTH "${traced}" submission_samples rows)
    if(NOT count EQUAL rows)
      message(FATAL_ERROR "Submission/frame row count mismatch")
    endif()
  else()
    string(JSON optional ERROR_VARIABLE absent GET "${traced}" submission_samples)
    if(NOT absent)
      message(FATAL_ERROR "Default run enabled submission timing")
    endif()
  endif()
  if(mode MATCHES "^prep")
    string(JSON count LENGTH "${traced}" preparation_samples rows)
    string(JSON clock GET "${traced}" preparation_samples clock)
    string(JSON resolution GET "${traced}" preparation_samples resolution_ns)
    if(NOT count EQUAL rows OR NOT clock STREQUAL "CLOCK_THREAD_CPUTIME_ID" OR resolution LESS_EQUAL 0)
      message(FATAL_ERROR "Missing preparation rows or clock metadata")
    endif()
  else()
    string(JSON optional ERROR_VARIABLE absent GET "${traced}" preparation_samples)
    if(NOT absent)
      message(FATAL_ERROR "Preparation profiling is not opt-in")
    endif()
  endif()
  set(completed 0)
  set(max_frame 0)
  foreach(i RANGE 0 23)
    math(EXPR expected "(${i} / 12) * 15 + 4 + ${i} % 12")
    string(JSON tag GET "${traced}" frame_samples rows ${i} frame)
    string(JSON status GET "${traced}" frame_samples rows ${i} gpu_status)
    string(JSON duration GET "${traced}" frame_samples rows ${i} cpu_ms 6)
    if(NOT tag EQUAL expected OR duration LESS 0)
      message(FATAL_ERROR "Wrong trace frame tag/duration")
    endif()
    if(mode MATCHES "^(split|prep)")
      string(JSON split_tag GET "${traced}" submission_samples rows ${i} frame)
      string(JSON render GET "${traced}" submission_samples rows ${i} render_ms)
      string(JSON submit GET "${traced}" frame_samples rows ${i} cpu_ms 3)
      string(JSON batches GET "${traced}" submission_samples rows ${i} batches)
      string(JSON bytes GET "${traced}" submission_samples rows ${i} upload_bytes)
      if(NOT split_tag EQUAL tag OR render GREATER submit OR NOT batches EQUAL 1 OR NOT bytes EQUAL 21504)
        message(FATAL_ERROR "Invalid submission interval or batch accounting")
      endif()
      foreach(component RANGE 0 2)
        string(JSON value GET "${traced}" submission_samples rows ${i} cpu_ms ${component})
        if(value LESS 0 OR value GREATER render)
          message(FATAL_ERROR "Invalid nested submission duration")
        endif()
      endforeach()
    endif()
    if(mode MATCHES "^prep")
      string(JSON prep_tag GET "${traced}" preparation_samples rows ${i} frame)
      if(NOT prep_tag EQUAL tag)
        message(FATAL_ERROR "Wrong preparation frame tag")
      endif()
      foreach(phase RANGE 0 3)
        string(JSON wall GET "${traced}" preparation_samples rows ${i} phases ${phase} 0)
        string(JSON cpu GET "${traced}" preparation_samples rows ${i} phases ${phase} 1)
        string(JSON gl_wall GET "${traced}" preparation_samples rows ${i} phases ${phase} 2)
        string(JSON gl_cpu GET "${traced}" preparation_samples rows ${i} phases ${phase} 3)
        if(wall LESS 0 OR cpu LESS 0 OR gl_wall LESS 0 OR gl_cpu LESS 0 OR gl_wall GREATER wall OR gl_cpu GREATER cpu)
          message(FATAL_ERROR "Invalid nested preparation phase")
        endif()
      endforeach()
    endif()
    if(duration GREATER max_frame)
      set(max_frame ${duration})
    endif()
    if(status STREQUAL "completed")
      math(EXPR completed "${completed} + 1")
      string(JSON gpu GET "${traced}" frame_samples rows ${i} gpu_ms)
      string(JSON collected GET "${traced}" frame_samples rows ${i} gpu_collected_after)
      if(gpu LESS 0 OR collected LESS tag OR collected GREATER 30)
        message(FATAL_ERROR "GPU result paired to the wrong frame")
      endif()
    elseif(status STREQUAL "uncollected" OR status STREQUAL "not_submitted")
      foreach(field gpu_ms gpu_collected_after)
        string(JSON kind TYPE "${traced}" frame_samples rows ${i} ${field})
        if(NOT kind STREQUAL "NULL")
          message(FATAL_ERROR "Missing GPU result is not null")
        endif()
      endforeach()
    else()
      message(FATAL_ERROR "Unknown GPU sample status")
    endif()
  endforeach()
  string(JSON aggregate GET "${traced}" milliseconds gpu_render samples)
  string(JSON maximum GET "${traced}" milliseconds frame max)
  if(NOT completed EQUAL aggregate OR NOT max_frame EQUAL maximum)
    message(FATAL_ERROR "Trace/aggregate mismatch")
  endif()

endforeach()
