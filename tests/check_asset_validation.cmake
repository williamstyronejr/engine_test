function(run expected pattern)
  execute_process(COMMAND ${environment} "${exe}" ${ARGN}
    WORKING_DIRECTORY "${WORK_ROOT}/cwd" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT result EQUAL expected OR NOT "${output}${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "Unexpected validator result ${result}: ${output}${error}")
  endif()
endfunction()
