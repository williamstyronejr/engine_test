cmake_minimum_required(VERSION 3.21)
file(REMOVE_RECURSE "${WORK_ROOT}")
file(MAKE_DIRECTORY "${WORK_ROOT}/bin" "${WORK_ROOT}/cwd/assets")
file(WRITE "${WORK_ROOT}/cwd/assets/facility.scene" "Misleading CWD assets\n")
file(COPY "${VALIDATOR}" DESTINATION "${WORK_ROOT}/bin")
set(exe "${WORK_ROOT}/bin/validate_assets")
set(environment "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY)
function(run expected pattern)
  execute_process(COMMAND ${environment} "${exe}" ${ARGN}
    WORKING_DIRECTORY "${WORK_ROOT}/cwd" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT result EQUAL expected OR NOT "${output}${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "Unexpected validator result ${result}: ${output}${error}")
  endif()
endfunction()
run(0 "Usage:" --help)
run(2 "Usage:" --unknown)
run(2 "Usage:" --assets)
run(2 "Usage:" --assets "${ASSET_ROOT}" --help)
run(1 "Cannot find assets")
run(0 "20 checks, 0 failed" --assets "${ASSET_ROOT}")
file(COPY "${ASSET_ROOT}/" DESTINATION "${WORK_ROOT}/bin/assets")
file(GLOB_RECURSE files RELATIVE "${WORK_ROOT}/bin/assets" "${WORK_ROOT}/bin/assets/*")
foreach(file IN LISTS files)
  file(SHA256 "${WORK_ROOT}/bin/assets/${file}" "before_${file}")
endforeach()
run(0 "20 checks, 0 failed")
file(GLOB_RECURSE after_files RELATIVE "${WORK_ROOT}/bin/assets" "${WORK_ROOT}/bin/assets/*")
if(NOT "${after_files}" STREQUAL "${files}")
  message(FATAL_ERROR "Validator changed the asset inventory")
endif()
foreach(file IN LISTS files)
  file(SHA256 "${WORK_ROOT}/bin/assets/${file}" after)
  if(NOT after STREQUAL "${before_${file}}")
    message(FATAL_ERROR "Validator changed ${file}")
  endif()
endforeach()
file(APPEND "${WORK_ROOT}/bin/assets/annex.scene" "unexpected\n")
run(1 "annex.scene.*Data after end")
file(REMOVE "${WORK_ROOT}/bin/assets/sounds/door.wav")
run(1 "sounds/door.wav.*Not a regular asset file")

# An isolated root with no Feature Lab bundle; each explicit decoder is exercised.
set(isolated "${WORK_ROOT}/work in progress")
file(MAKE_DIRECTORY "${isolated}")
set(types scene tilemap animation texture font sound)
set(sources facility.scene annex.etmp facility.eani textures/actors.etex fonts/ui.efnt sounds/door.wav)
foreach(i RANGE 0 5)
  list(GET types ${i} type)
  list(GET sources ${i} source)
  configure_file("${ASSET_ROOT}/${source}" "${isolated}/draft.data" COPYONLY)
  run(0 "1 check, 0 failed" --file draft.data --assets "${isolated}" --type "${type}")
  file(WRITE "${isolated}/draft.data" "corrupt")
  run(1 "1 check, 1 failed" --type "${type}" --file draft.data --assets "${isolated}")
endforeach()
file(WRITE "${isolated}/draft.data" "scene 1\nend\n")
run(0 "scene budget=0" --assets "${isolated}" --type scene --file draft.data --scene-budget 0)
run(0 "scene budget=4096" --assets "${isolated}" --type scene --file draft.data)
run(1 "Not a regular asset file" --assets "${isolated}" --type scene --file missing.scene)
run(1 "Invalid asset path" --assets "${isolated}" --type scene --file ../draft.data)
foreach(budget -1 +1 4097 1.5 1x 99999999999999999999999999)
  run(2 "Scene budget" --type scene --file draft.data --scene-budget "${budget}")
endforeach()
run(2 "must be used together" --type scene)
run(2 "must be used together" --file draft.data)
run(2 "Unknown asset type" --type shader --file draft.data)
run(2 "requires --type scene" --scene-budget 2)
run(2 "requires --type scene" --type texture --file draft.data --scene-budget 2)
run(2 "repeated option" --type scene --type scene --file draft.data)
run(2 "repeated option" --type scene --file a --file b)
run(2 "repeated option" --assets a --assets b)
run(2 "repeated option" --type scene --file a --scene-budget 0 --scene-budget 1)
run(2 "Missing option value" --type scene --file)
