string(JSON requested GET "${json}" requested_root)
string(JSON file GET "${json}" file)
if(NOT "${requested}" STREQUAL "${quoted_root}" OR NOT file STREQUAL "draft\".scene")
  message(FATAL_ERROR "Quoted path did not round-trip")
endif()
run_json(1 file ON OFF 1 1 --json --assets "${isolated}" --type scene --file "bad\\name")
string(JSON file GET "${json}" file)
if(NOT file STREQUAL "bad\\name")
  message(FATAL_ERROR "Invalid path bytes lost")
endif()
foreach(args IN ITEMS "--json;--type;bad;--file;x" "--json;--json" "--unknown;--json")
  execute_process(COMMAND ${environment} "${exe}" ${args} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 2 OR NOT output STREQUAL "" OR NOT error MATCHES "Usage:")
    message(FATAL_ERROR "Argument errors must retain stderr-only text")
  endif()
endforeach()
# /dev/full rejects the report write after validation; do not report CLI success.
execute_process(COMMAND ${environment} "${exe}" --json --assets "${ASSET_ROOT}"
  OUTPUT_FILE /dev/full ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 15)
if(NOT result EQUAL 1 OR NOT error MATCHES "Cannot write asset validation report")
  message(FATAL_ERROR "JSON output failure was not detected: ${result}: ${error}")
endif()
