# Parse JSON with CMake's independent JSON reader, including all field types.
function(run_json expected expected_mode expected_complete expected_passed expected_count expected_failed)
  execute_process(COMMAND ${environment} "${exe}" ${ARGN}
    WORKING_DIRECTORY "${WORK_ROOT}/cwd" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT result EQUAL expected OR NOT "${error}" STREQUAL "")
    message(FATAL_ERROR "JSON invocation failed: ${result}: ${output}${error}")
  endif()
  string(JSON schema GET "${output}" schema)
  string(JSON encoding GET "${output}" string_encoding)
  string(JSON mode GET "${output}" mode)
  string(JSON complete GET "${output}" complete)
  string(JSON passed GET "${output}" passed)
  string(JSON count GET "${output}" check_count)
  string(JSON failed GET "${output}" failed_checks)
  string(JSON length LENGTH "${output}" checks)
  foreach(field complete passed)
    string(JSON type TYPE "${output}" ${field})
    if(NOT type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "${field} must be Boolean")
    endif()
  endforeach()
  if(NOT schema STREQUAL "engine_asset_validation_v1" OR NOT encoding STREQUAL "byte_values" OR
     NOT mode STREQUAL expected_mode OR NOT complete STREQUAL expected_complete OR
     NOT passed STREQUAL expected_passed OR NOT count EQUAL expected_count OR
     NOT length EQUAL count OR NOT failed EQUAL expected_failed)
    message(FATAL_ERROR "Unexpected JSON summary: ${output}")
  endif()
  set(json "${output}" PARENT_SCOPE)
endfunction()
run_json(0 bundle ON ON 20 0 --json --assets "${ASSET_ROOT}")
foreach(field format file fatal_error)
  string(JSON type TYPE "${json}" ${field})
  if(NOT type STREQUAL "NULL")
    message(FATAL_ERROR "Bundle ${field} must be null")
  endif()
endforeach()
string(JSON budget GET "${json}" scene_budget)
if(NOT budget EQUAL 256)
  message(FATAL_ERROR "Bundle budget missing")
endif()
foreach(i RANGE 0 19)
  string(JSON passed GET "${json}" checks ${i} passed)
  string(JSON diagnostic TYPE "${json}" checks ${i} diagnostic)
  if(NOT passed OR NOT diagnostic STREQUAL "NULL")
    message(FATAL_ERROR "Successful check diagnostics invalid")
  endif()
endforeach()
set(first "${json}")
run_json(0 bundle ON ON 20 0 --assets "${ASSET_ROOT}" --json)
if(NOT "${first}" STREQUAL "${json}")
  message(FATAL_ERROR "Unchanged input did not produce identical JSON")
endif()
foreach(i RANGE 0 5)
  list(GET types ${i} type)
  list(GET sources ${i} source)
  run_json(0 file ON ON 1 0 --json --assets "${ASSET_ROOT}" --type "${type}" --file "${source}")
  string(JSON actual_format GET "${json}" format)
  string(JSON actual_file GET "${json}" file)
  string(JSON budget_type TYPE "${json}" scene_budget)
  if(NOT actual_format STREQUAL type OR NOT actual_file STREQUAL source)
    message(FATAL_ERROR "File selection missing")
  endif()
  if(type STREQUAL "scene")
    string(JSON budget GET "${json}" scene_budget)
    if(NOT budget EQUAL 4096)
      message(FATAL_ERROR "Default scene budget missing")
    endif()
  elseif(NOT budget_type STREQUAL "NULL")
    message(FATAL_ERROR "Non-scene budget must be null")
  endif()
endforeach()
