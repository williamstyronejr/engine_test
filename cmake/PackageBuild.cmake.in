cmake_minimum_required(VERSION 3.21)
include("@CMAKE_CURRENT_SOURCE_DIR@/cmake/PackageSupport.cmake")
if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "Release" OR "@ENGINE_SANITIZERS@" OR "@CMAKE_CROSSCOMPILING@")
  message(FATAL_ERROR "release_package requires a native Release build with ENGINE_SANITIZERS=OFF")
endif()
set(build "@CMAKE_CURRENT_BINARY_DIR@")
set(name "feature-lab-@PROJECT_VERSION@-Linux-@CMAKE_SYSTEM_PROCESSOR@-@STRESS_REVISION@")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${build}/packaging/work-${id}")
set(prefix "${work}/stage/${name}")
file(MAKE_DIRECTORY "${prefix}" "${build}/dist")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "${build}" --config Release --prefix "${prefix}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Package install failed: ${output}${error}")
endif()
configure_file("@CMAKE_CURRENT_SOURCE_DIR@/docs/PACKAGE_README.md" "${prefix}/README.md" COPYONLY)
configure_file("@CMAKE_CURRENT_BINARY_DIR@/generated/package-build-info.txt" "${prefix}/BUILD_INFO.txt" COPYONLY)
if(EXISTS "/etc/os-release")
  file(READ "/etc/os-release" os_release)
  file(APPEND "${prefix}/BUILD_INFO.txt" "\nBuild host /etc/os-release:\n${os_release}")
endif()
find_program(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND NAMES objdump REQUIRED)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM linux+elf)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(inventory "Build-host dependency inventory; these libraries are NOT bundled.\nDirect entries come from ELF NEEDED; resolved entries include transitive dependencies.\nDynamically selected GL/ALSA drivers and plugins are outside this static inventory.\n\n")
foreach(program IN ITEMS feature_lab stress_bench)
  execute_process(COMMAND "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}" -p "${prefix}/bin/${program}"
    RESULT_VARIABLE result OUTPUT_VARIABLE elf ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect ${program}: ${error}")
  endif()
  if(elf MATCHES "(RPATH|RUNPATH)[ \t]+[^\n]+")
    message(FATAL_ERROR "Package binaries must not require RPATH/RUNPATH: ${program}")
  endif()
  string(APPEND inventory "${program}: direct NEEDED\n")
  string(REGEX MATCHALL "NEEDED[ \t]+[^\n]+" needed "${elf}")
  foreach(entry IN LISTS needed)
    string(APPEND inventory "  ${entry}\n")
  endforeach()
  # Inspect version requirements too; do not infer support for older distributions.
  string(REGEX MATCHALL "(GLIBCXX|GLIBC|CXXABI)_[0-9.]+" versions "${elf}")
  list(REMOVE_DUPLICATES versions)
  list(SORT versions)
  string(JOIN ", " version_text ${versions})
  string(APPEND inventory "  Required symbol versions: ${version_text}\n")
  file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${prefix}/bin/${program}"
    RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicts)
  if(unresolved OR conflicts_FILENAMES)
    message(FATAL_ERROR "Unresolved/conflicting ${program} runtime dependencies: ${unresolved};${conflicts_FILENAMES}")
  endif()
  list(SORT resolved)
  string(APPEND inventory "${program}: resolved on build host\n")
  foreach(library IN LISTS resolved)
    string(APPEND inventory "  ${library}\n")
  endforeach()
  string(APPEND inventory "\n")
endforeach()
file(WRITE "${prefix}/RUNTIME_DEPENDENCIES.txt" "${inventory}")
package_manifest("${prefix}")
set(temporary "${work}/${name}.tar.gz")
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cfz "${temporary}" --format=gnutar "${name}"
  WORKING_DIRECTORY "${work}/stage" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot archive package: ${error}")
endif()
set(smoke_work "@ENGINE_PACKAGE_TEST_ROOT@/build-${id}")
package_extract("${temporary}" "${smoke_work}/extracted" extracted)
file(RENAME "${extracted}" "${smoke_work}/relocated prefix with spaces")
package_headless("${smoke_work}/relocated prefix with spaces" "${smoke_work}/checks")
file(REMOVE_RECURSE "${smoke_work}")
file(SHA256 "${temporary}" checksum)
file(WRITE "${work}/${name}.tar.gz.sha256" "${checksum}  ${name}.tar.gz\n")
# Publication occurs only after verification of the extracted, relocated archive.
file(RENAME "${temporary}" "${build}/dist/${name}.tar.gz")
file(RENAME "${work}/${name}.tar.gz.sha256" "${build}/dist/${name}.tar.gz.sha256")
file(WRITE "${build}/packaging/latest.txt" "${build}/dist/${name}.tar.gz\n")
file(REMOVE_RECURSE "${work}")
message(STATUS "Validated package: ${build}/dist/${name}.tar.gz")
